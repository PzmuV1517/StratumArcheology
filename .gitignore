# Root-level gitignore for STRATUM project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.ruff_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Build outputs
build/
dist/
.expo/
web-build/

# Allow specific exported web files to be tracked
!frontend/stratum-app/dist/assets
!frontend/stratum-app/dist/project
!frontend/stratum-app/dist/create-artefact.html
!frontend/stratum-app/dist/scan-qr.html

# MinIO/Storage
minio-data/
storage/

# Temporary files
*.tmp
*.temp
CHATGPT_CONTEXT_PROMPT.md

# Lock files (keep root, ignore nested)
frontend/stratum-app/package-lock.json

# Expo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# Testing
coverage/
.nyc_output/
